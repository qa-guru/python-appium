# DEVICE_HOST: selenoid | browserstack | emulator | real
DEVICE_HOST=selenoid

# School Selenoid farm (Android only). Creds go here, never into the URL.
# Defaults are the farm's public guest account; override if rotated.
SELENOID_URL=https://selenoid.qa.guru/wd/hub
SELENOID_USER=user1
SELENOID_PASSWORD=1234
# Android image version on the farm (catalog: 5.1, 15.0, 16.0)
PLATFORM_VERSION=16.0

# BrowserStack — your own account (App Automate)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP=bs://
BROWSERSTACK_PLATFORM=Android

# Local Android (emulator / real device) — path to the APK on this machine.
# UDID = device serial from `adb devices` (required for real, or when several
# emulators are booted).
# ANDROID_APP=./wikipedia-50611-r-2026-10-07.apk
# UDID=emulator-5554
# APPIUM_URL=http://127.0.0.1:4723

# iOS (macOS only): ios_simulator needs a simulator-built .app, ios_real needs
# the device UDID and uses the App Store build by bundleId.
# DEVICE_NAME=iPhone 16
# PLATFORM_VERSION=18.0
# IOS_APP=./Wikipedia.app
# UDID=<simulator uuid or iphone udid>
# BUNDLE_ID=org.wikipedia

WDA_LOCAL_PORT=8100
WDA_ALLOW_PROVISIONING=false
TIMEOUT=30
